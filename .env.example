# === REQUIRED ===
DATABASE_URL=              # Neon connection string (pooled)
AUTH_SECRET=               # Run: openssl rand -base64 32

# === GITHUB OAUTH (active by default) ===
AUTH_GITHUB_ID=            # GitHub → Settings → Developer Settings → OAuth Apps → New
AUTH_GITHUB_SECRET=

# === GOOGLE OAUTH (optional — uncomment provider in src/lib/auth.ts) ===
# AUTH_GOOGLE_ID=          # Google Cloud Console → APIs & Credentials → OAuth Client ID
# AUTH_GOOGLE_SECRET=      # Requires Google verification for public access

# === RESEND MAGIC LINK (optional — uncomment provider in src/lib/auth.ts) ===
# AUTH_RESEND_KEY=         # resend.com → API Keys (free: 3,000 emails/month shared across all projects)
